{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_STATIC_LIBRARY_PREFIX": "",
        "CMAKE_SHARED_LIBRARY_PREFIX": ""
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug Preset",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_CRT_LINKAGE": "dynamic"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release Preset",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_CRT_LINKAGE": "static"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug Preset",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "ON",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/custom-triplets",
        "VCPKG_TARGET_TRIPLET": "x64-linux-debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" }
  ]
}